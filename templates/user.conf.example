# Barista Dots — configuração local do usuário
# Copiado para ~/.config/dotfiles/user.conf no primeiro apply (não versionado).
# Edite paths de apps opcionais aqui.

DOTFILES_USER="${USER}"

# Apps (Super+T/C/B/E)
TERMINAL_CMD="alacritty"
TERMINAL_CLASS="Alacritty"
BROWSER_CMD="zen-browser"
BROWSER_CLASS="zen"
FILE_MANAGER_CMD="thunar"
CURSOR_APP="${HOME}/Applications/cursor.AppImage"
EDITOR_CMD="${CURSOR_APP} --no-sandbox"
