configuration {
    display-drun: " ";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
    modi: "drun";
    show-icons: true;
}

@theme "/dev/null"
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 35%;
    border: 1px;
    border-color: rgba(166, 177, 225, 0.3);
    border-radius: 12px;
    background-color: @bg;
    padding: 20px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px;
    margin: 0 0 15px 0;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 13";
    padding: 2px 8px 0 4px;
}

entry {
    placeholder: "Procurar aplicativo...";
    placeholder-color: rgba(244, 238, 255, 0.35);
    text-color: @fg;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
}

element selected {
    background-color: rgba(166, 177, 225, 0.25);
    text-color: @fg;
    border: 1px;
    border-color: @accent;
}

element-icon {
    size: 24px;
    padding: 0 12px 0 0;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
