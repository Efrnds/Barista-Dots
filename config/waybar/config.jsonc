{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "hyprland/workspaces",
        "group/system-stats",
        "custom/updates"
    ],
    "modules-center": [
        "mpris",
        "clock",
        "custom/wallpaper",
        "custom/notification"
    ],
    "modules-right": [
        "group/connections",
        "group/media",
        "custom/power_draw",
        "battery",
        "custom/power"
    ],

    "group/system-stats": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "disk"
        ]
    },

    "group/connections": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth"
        ]
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "backlight"
        ]
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": {
            "1": [], "2": [], "3": [], "4": [], "5": []
        },
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "cpu": {
        "format": " {usage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "tooltip": true
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G/{total:0.1f}G ({percentage}%)",
        "states": {
            "warning": 80,
            "critical": 95
        }
    },

    "disk": {
        "interval": 60,
        "format": " {percentage_used}%",
        "path": "/",
        "states": {
            "warning": 85,
            "critical": 95
        }
    },

    "custom/updates": {
        "format": "  {}",
        "exec": "checkupdates | wc -l",
        "interval": 3600,
        "tooltip-format": "Pacotes aguardando atualização"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%d/%m/%Y}"
    },

    "custom/notification": {
        "format": "",
        "on-click": "~/.config/hypr/scripts/rofi_notifications.sh",
        "tooltip-format": "Gerenciador de Notificações (Rofi)"
    },

    "custom/wallpaper": {
        "format": "🖼️",
        "on-click": "~/.config/hypr/mudar_fundo.sh",
        "on-click-right": "~/.config/hypr/scripts/rofi_wallpapers.sh",
        "on-click-middle": "~/.config/hypr/mudar_fundo.sh --like",
        "tooltip-format": "Botão Esquerdo: Novo Wallpaper\nBotão Direito: Menu de Temas Rofi\nBotão do Meio: Curtir/Salvar Wallpaper"
    },

    "mpris": {
        "format": "{status_icon} {artist} - {title}",
        "format-paused": "{status_icon} <i>{artist} - {title}</i>",
        "status-icons": {
            "playing": "󰎆 ",
            "paused": "󰏤 "
        },
        "max-length": 30,
        "ellipsis": "..."
    },

    "network": {
        "format-wifi": "    {bandwidthDownOctets}   {bandwidthUpOctets}",
        "format-ethernet": "   {bandwidthDownOctets}   {bandwidthUpOctets}",
        "format-disconnected": "⚠",
        "tooltip-format": "{ifname} via {gwaddr}\nVelocidade Total: {bandwidthTotalOctets}",
        "on-click": "~/.config/hypr/scripts/rofi-wifi.sh",
        "interval": 5
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  Mutado",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "on-click": "~/.config/hypr/scripts/rofi-bluetooth.sh"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/power_draw": {
        "format": "{}",
        "interval": 2,
        "exec": "~/.config/waybar/scripts/power_draw.py",
        "tooltip": false
    },

    "custom/power": {
        "format": "",
        "on-click": "wlogout -b 3",
        "tooltip": false
    }
}
