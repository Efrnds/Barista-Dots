{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2
    },
    "color": {
      "1": "magenta",
      "2": "blue"
    }
  },
  "display": {
    "separator": "  ❯  ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS  ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "󰔚 KRN ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "󰅐 UPT ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "󰞷 SHL ",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "󱂬 WM  ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "󰞷 TRM ",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "󰍛 MEM ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
