# Backups locais / lixo
*.bak
*.bak.*
*.backup*
.DS_Store
config/niri/config.kdl.backup*

# Hypr — mídia grande (não versionar)
config/hypr/current_wallpaper.jpg
config/hypr/current_wallpaper.mp4
config/hypr/current_wallpaper.webp
config/hypr/avatar.jpg
config/hypr/.dms-backups/
*.pre-dotfiles-*

# Pack de wallpapers (baixar via fetch-wallpapers.sh / barista-wallpapers)
wallpapers/*
!wallpapers/README.md

# DMS — estado local da primeira execução
config/DankMaterialShell/.firstlaunch
config/DankMaterialShell/.changelog-*

# Dotfiles — configs gerados (use templates/)
config/foot/foot.ini
config/spicetify/config-xpui.ini
config/tmux/plugins/

# User-local (não versionar)
**/.config/dotfiles/user.conf

# Secrets (nunca commitar)
config/hypr/rdp-server.conf
**/secrets*
**/*.secret
**/.env

# Caches / locks
**/__pycache__/
**/.venv/
**/node_modules/
